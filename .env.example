# ============================================================
# McFit Agent · 环境变量示例
# 复制为 .env 后按需填写；.env 不会被 Git 跟踪，也不要提交真实密钥。
# 不含真实凭证；默认不读取本机私人配置，仅显式开关允许时读取。
# ============================================================

# ---------- 麦当劳 MCP（必需）----------
# 没有 Token 时：菜单、营养、核价、推荐全部不可用，接口会明确返回「无法获取菜单」
MCD_MCP_TOKEN=
# 可选：MCP 服务地址与超时/并发（默认值见 src/config.js）
# MCD_MCP_URL=https://mcp.mcd.cn
# MCD_MCP_TIMEOUT_MS=20000
# MCD_MCP_CONCURRENCY=10
# MCD_MCP_MAX_RETRIES=2

# ---------- 门店 ----------
# 默认门店：济南凤鸣广场餐厅（3350241）。换门店只需改这里或用页面上的「换一家门店」
MCFIT_STORE_CODE=3350241
MCFIT_STORE_NAME=麦当劳济南凤鸣广场餐厅
# MCFIT_STORE_SEARCH_CITY=济南
# MCFIT_STORE_SEARCH_KEYWORD=凤鸣广场

# ---------- 服务 ----------
PORT=5173

# ---------- 大模型（可选）----------
# 不配置时：自然语言解析自动降级为规则解析（仍可推荐，但语义理解能力较弱）
# 需要 OpenAI 兼容的 /chat/completions 端点
MCFIT_LLM_BASE_URL=
MCFIT_LLM_API_KEY=
MCFIT_LLM_MODEL=mimo-v2.6-pro
# 关闭模型调用，强制走规则解析（用于验证降级路径）
# MCFIT_LLM_DISABLE=1
# 可选：thinking 参数（默认 disabled，关闭推理以降低延迟）
# MCFIT_LLM_THINKING=disabled
# MCFIT_LLM_TIMEOUT_MS=20000
# MCFIT_LLM_MAX_TOKENS=800

# ---------- 缓存 TTL（毫秒）----------
MCFIT_TTL_MENU_MS=1800000
MCFIT_TTL_DETAIL_MS=43200000
MCFIT_TTL_NUTRITION_MS=86400000
MCFIT_TTL_PRICE_MS=300000

# ---------- 运行时行为 ----------
# 启动时预热候选池与参考价（0=关闭）
MCFIT_PREWARM=1
# 任何模式默认不读取本机配置，设为 1 才允许对应读取（不建议公开环境开启）
NODE_ENV=production
MCFIT_LLM_ALLOW_LOCAL=0
MCFIT_ALLOW_LOCAL_MCP=0
